# ============================================================
# E. coli ExPEC pipeline — .gitignore
# ============================================================

# ---- Secrets ----
.env
*.key
*.pem
credentials*

# ---- Raw genome data (downloaded, huge, reproducible) ----
/ST10/
/ST69/
/ST73/
/ST95/
/ST131/
/ST10_subsampled_*/
/ST69_subsampled_*/
/ST73_subsampled_*/
/ST95_subsampled_*/
/ST131_subsampled_*/
*.fna
*.fna.gz
*.fa
*.fasta

# ---- Annotations / database outputs (regenerable) ----
/annotation/
/analysis_results/
/finder_result/
/card_vfdb_result/
/pangenome_output/
/metadata_matched/
*.treefile
*.gff
*.gbk
*.faa
*.ffn

# ---- Outputs / figures ----
/output/
/outputs/
*.pdf
*.png
*.tiff

# ---- Selected-genome lists ----
/selected_*.txt

# ---- macOS ----
.DS_Store

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
venv/
.venv/

# ---- R ----
.Rhistory
.RData
.Rproj.user/
.Ruserdata

# ---- Logs / temp ----
*.log
*.tmp
.tmp_*.R
